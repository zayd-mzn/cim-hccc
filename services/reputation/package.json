{
  "name": "@agent-market/reputation",
  "version": "0.1.0",
  "description": "Reputation engine: stateless, replayable provider scores computed from the HCS audit log + AgentEscrow events on the Mirror Node. (Youssef)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-market-reputation": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "report": "tsx src/cli.ts"
  },
  "dependencies": {
    "@agent-market/protocol": "workspace:*",
    "@agent-market/hedera-core": "workspace:*",
    "@noble/hashes": "1.8.0"
  }
}
