{
  "name": "agent-market",
  "version": "0.1.0",
  "private": true,
  "description": "A marketplace where autonomous AI agents discover, negotiate, and buy services from each other on Hedera.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "demo": "pnpm --filter @agent-market/consumer demo",
    "demo:testnet": "pnpm --filter @agent-market/consumer demo:testnet",
    "demo:external": "pnpm --filter @agent-market/external-agent-demo build && pnpm --filter @agent-market/mcp-server build && pnpm --filter @agent-market/external-agent-demo start",
    "start:mcp": "pnpm --filter @agent-market/mcp-server start",
    "demo:x402": "pnpm --filter @agent-market/x402 demo",
    "reputation": "pnpm --filter @agent-market/reputation report",
    "dashboard": "pnpm --filter @agent-market/dashboard dev",
    "dashboard:build": "pnpm --filter @agent-market/dashboard build"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "vitest": "2.1.5",
    "@types/node": "22.9.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  }
}
