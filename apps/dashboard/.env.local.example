# Dashboard local env — copy to .env.local and override as needed.
#   cp .env.local.example .env.local
# .env.local is gitignored. The dashboard is read-only and only ever talks to
# the public Hedera Mirror Node — no backend, no keys.

# Mirror Node base (default: Hedera testnet public mirror node).
VITE_MIRROR_BASE=https://testnet.mirrornode.hedera.com

# On-chain ids (defaults are the live testnet ids from reports/hcs-format-for-dashboard.md).
VITE_TOPIC_ID=0.0.11431745
VITE_TOKEN_ID=0.0.11431744
VITE_ESCROW_ID=0.0.11431806

# Set to 1 to force mock data (offline demo), ignoring the Mirror Node.
VITE_USE_MOCK=
